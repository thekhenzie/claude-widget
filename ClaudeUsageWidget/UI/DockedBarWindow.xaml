<Window x:Class="ClaudeUsageWidget.UI.DockedBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Width="244" Height="42"
        Left="-1000" Top="-1000">
    <Border x:Name="RootBorder" CornerRadius="6" Background="#CC1E1E1E" Padding="6,4">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh now" Click="OnRefreshClick" />
                <MenuItem Header="Open claude.ai usage page" Click="OnOpenUsagePageClick" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <!-- Row 1: percentage pills + menu -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SessionPill" Grid.Column="0" Width="92" Height="16" HorizontalAlignment="Left" CornerRadius="8" Background="#3A3A3A">
                    <Grid>
                        <Border x:Name="SessionFill" HorizontalAlignment="Left" Width="0" CornerRadius="8" Background="#E2703A" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="White" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="SessionPctText" Text="--%" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SessionTimeText" Text="--:--" Foreground="#F0FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="WeeklyPill" Grid.Column="2" Width="92" Height="16" HorizontalAlignment="Left" CornerRadius="8" Background="#3A3A3A">
                    <Grid>
                        <Border x:Name="WeeklyFill" HorizontalAlignment="Left" Width="0" CornerRadius="8" Background="#3E8EF7" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="White" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="WeeklyPctText" Text="--%" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="WeeklyTimeText" Text="--:--" Foreground="#F0FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Background="#33FFFFFF" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="OnMenuButtonClick">
                    <TextBlock Text="&#9776;" Foreground="#DDDDDD" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Row 2: reset countdowns + close + clock -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SessionResetText" Grid.Column="0" Text="reset --" Foreground="#AAAAAA" FontSize="11" />
                <TextBlock x:Name="WeeklyResetText" Grid.Column="1" Text="reset --" Foreground="#AAAAAA" FontSize="11" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="CloseButton" Text="&#10005;" Foreground="#AAAAAA" FontSize="9"
                               Cursor="Hand" MouseLeftButtonUp="OnExitClick" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ClockText" Text="--:--" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
