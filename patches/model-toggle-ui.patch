+    private void RefreshModelButtons()
+    {
+        var current = _modelSetting.Read();
+        ApplyModelButtonStyle(OpusButton, OpusButtonText, current == ClaudeModelChoice.Opus);
+        ApplyModelButtonStyle(SonnetButton, SonnetButtonText, current == ClaudeModelChoice.Sonnet);
+    }
+
+    private static void ApplyModelButtonStyle(System.Windows.Controls.Border button, System.Windows.Controls.TextBlock text, bool active)
+    {
+        button.Background = active ? ModelActiveBackground : ModelInactiveBackground;
+        text.Foreground = active ? ModelActiveForeground : ModelInactiveForeground;
+        text.FontWeight = active ? FontWeights.Bold : FontWeights.Normal;
+    }
+
+    private void OnOpusButtonClick(object sender, MouseButtonEventArgs e) => SwitchModel(ClaudeModelChoice.Opus);
+
+    private void OnSonnetButtonClick(object sender, MouseButtonEventArgs e) => SwitchModel(ClaudeModelChoice.Sonnet);
+
+    private void SwitchModel(ClaudeModelChoice choice)
+    {
+        try
+        {
+            _modelSetting.Write(choice);
+        }
+        catch (Exception ex)
+        {
+            MessageBox.Show($"Couldn't update Claude Code settings.json:\n{ex.Message}", "Claude Usage",
+                MessageBoxButton.OK, MessageBoxImage.Warning);
+        }
+
+        RefreshModelButtons();
+    }
+
+    private static Brush Freeze(Brush brush)
+    {
+        brush.Freeze();
+        return brush;
+    }
